{
  "extends": "@istanbuljs/nyc-config-babel",
  "all": true,
  "include": [
    "src/**/*.js"
  ],
  "exclude": [
    "src/index.js",
    "tests/**",
    "coverage/**",
    "node_modules/**",
    "*.config.js"
  ],
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov",
    "json"
  ],
  "report-dir": "coverage",
  "temp-dir": ".nyc_output",
  "check-coverage": true,
  "lines": 80,
  "statements": 80,
  "functions": 80,
  "branches": 70,
  "watermarks": {
    "lines": [70, 85],
    "functions": [70, 85],
    "branches": [60, 75],
    "statements": [70, 85]
  },
  "cache": true,
  "babel": true,
  "exclude-after-remap": false
}