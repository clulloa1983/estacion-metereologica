# InfluxDB Backup Configuration
# Copiar este archivo como .env.backup.local y ajustar según necesidades

# Programación de backup (formato cron)
# Default: 0 2 * * * (Todos los días a las 2:00 AM)
# Ejemplos:
#   0 */6 * * *     - Cada 6 horas
#   0 0 */3 * *     - Cada 3 días a medianoche
#   0 1 * * 1       - Cada lunes a la 1:00 AM
BACKUP_SCHEDULE=0 2 * * *

# Retención de backups (días)
BACKUP_RETENTION_DAYS=7

# Configuración InfluxDB (debe coincidir con .env principal)
INFLUXDB_ORG=weather-station
INFLUXDB_ADMIN_TOKEN=weather-station-token-12345

# Directorio de backups (relativo al proyecto)
BACKUP_DIR=./backups

# Configuraciones adicionales
BACKUP_COMPRESS=true
BACKUP_LOG_LEVEL=INFO

# Notificaciones (opcional - para implementación futura)
# BACKUP_WEBHOOK_URL=
# BACKUP_NOTIFY_EMAIL=